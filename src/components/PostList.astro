---
import { formatDate, url } from '../utils';
import { tagColors } from '../cover';
const { posts } = Astro.props;
---
<ul class="posts">
  {posts.map((p) => {
    const { from, to } = tagColors(p.data.tags[0] ?? '');
    const href = url(`/blog/${p.id}/`);
    return (
      <li>
        <a class="thumb" href={href} tabindex="-1" aria-hidden="true" style={`--from: ${from}; --to: ${to}`}></a>
        <div class="post-body">
          <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
          <a href={href}>{p.data.title}</a>
          <p>{p.data.description}</p>
        </div>
      </li>
    );
  })}
</ul>
