---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { url } from '../utils';
const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`}</title>
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={url('/rss.xml')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <header>
      <a class="brand" href={url('/')}>{SITE_TITLE}</a>
      <nav>
        <a href={url('/')}>Bài viết</a>
        <a href={url('/tags/')}>Tag</a>
        <a href={url('/services/')}>Dịch vụ</a>
        <a href={url('/about/')}>Giới thiệu</a>
        <a href={url('/rss.xml')}>RSS</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>© {new Date().getFullYear()} {SITE_TITLE}</footer>
  </body>
</html>
