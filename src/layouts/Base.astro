---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, LANGUAGE_TAGS, GA_MEASUREMENT_ID } from '../consts';
import { url } from '../utils';
interface Props {
  title?: string;
  description?: string;
  /** Ảnh chia sẻ: đường dẫn trong site ("/og/abc.png") hoặc URL đầy đủ. */
  image?: string;
  type?: 'website' | 'article';
  /** Trang rộng (landing page). */
  wide?: boolean;
}
const { title = SITE_TITLE, description = SITE_DESCRIPTION, image, type = 'website', wide = true } = Astro.props;
const path = Astro.url.pathname;
const active = (prefix: string) => path.startsWith(url(prefix));
const imageUrl = image && new URL(image.startsWith('/') ? url(image) : image, Astro.site).href;
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`}</title>
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={url('/rss.xml')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:site_name" content={SITE_TITLE} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:width" content="1200" />}
    {imageUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {GA_MEASUREMENT_ID && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script is:inline define:vars={{ id: GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag("js", new Date());
          gtag("config", id);
        </script>
      </>
    )}
  </head>
  <body class:list={{ wide }}>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={url('/')} aria-label={`${SITE_TITLE}, trang chủ`}>
          <span class="brand-mark" aria-hidden="true">Q</span>
          <span class="brand-name">{SITE_TITLE}</span>
        </a>
        <nav class="site-nav" aria-label="Điều hướng chính">
          <a href={url('/posts/')} aria-current={active('/posts/') || active('/blog/') ? 'page' : undefined}>Bài viết</a>
          <details class="dropdown">
            <summary aria-current={active('/tags/') ? 'page' : undefined}>Chủ đề</summary>
            <div class="dropdown-panel">
              {LANGUAGE_TAGS.map(({ tag, label }) => <a href={url(`/tags/${tag}/`)}>{label}</a>)}
              <a class="all" href={url('/tags/')}>Tất cả chủ đề</a>
            </div>
          </details>
          <a href={url('/series/')} aria-current={active('/series/') ? 'page' : undefined}>Series</a>
          <a href={url('/services/')} aria-current={active('/services/') ? 'page' : undefined}>Dịch vụ</a>
          <a href={url('/about/')} aria-current={active('/about/') ? 'page' : undefined}>Giới thiệu</a>
          <a class="rss" href={url('/search/')} title="Tìm kiếm (phím /)" aria-label="Tìm kiếm" aria-current={active('/search/') ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M10 2a8 8 0 0 1 6.32 12.9l5.39 5.4-1.41 1.4-5.4-5.39A8 8 0 1 1 10 2zm0 2a6 6 0 1 0 0 12 6 6 0 0 0 0-12z"/></svg>
          </a>
          <a class="rss" href={url('/rss.xml')} title="RSS" aria-label="RSS">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M5 3a16 16 0 0 1 16 16h-3A13 13 0 0 0 5 6V3zm0 6a10 10 0 0 1 10 10h-3a7 7 0 0 0-7-7V9zm2 8a2 2 0 1 1 0 4 2 2 0 0 1 0-4z"/></svg>
          </a>
          <a class="nav-cta" href={url('/contact/')}>Liên hệ</a>
        </nav>
        <details class="mobile-menu">
          <summary aria-label="Mở menu"><span></span><span></span><span></span></summary>
          <div class="mobile-panel">
            <a href={url('/search/')}>Tìm kiếm</a>
            <a href={url('/posts/')}>Bài viết</a>
            {LANGUAGE_TAGS.map(({ tag, label }) => <a class="sub" href={url(`/tags/${tag}/`)}>{label}</a>)}
            <a class="sub" href={url('/tags/')}>Tất cả chủ đề</a>
            <a href={url('/series/')}>Series</a>
            <a href={url('/services/')}>Dịch vụ</a>
            <a href={url('/about/')}>Giới thiệu</a>
            <a href={url('/rss.xml')}>RSS</a>
            <a class="nav-cta" href={url('/contact/')}>Liên hệ</a>
          </div>
        </details>
      </div>
    </header>
    <script is:inline>
      // Đóng dropdown khi bấm ra ngoài hoặc nhấn Esc.
      document.addEventListener('click', (e) => {
        document.querySelectorAll('.site-header details[open]').forEach((d) => { if (!d.contains(e.target)) d.open = false; });
      });
      document.addEventListener('keydown', (e) => {
        // Phím "/" mở trang tìm kiếm (trừ khi đang gõ trong ô nhập liệu).
        const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement?.tagName ?? '') || document.activeElement?.isContentEditable;
        if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey) {
          e.preventDefault();
          const box = document.getElementById('q');
          if (box) box.focus(); else location.href = document.querySelector('.site-nav a[href$="/search/"]').href;
        }
        if (e.key === 'Escape') document.querySelectorAll('.site-header details[open]').forEach((d) => (d.open = false));
      });
    </script>
    <main><slot /></main>
    <footer>© {new Date().getFullYear()} {SITE_TITLE}</footer>
  </body>
</html>
