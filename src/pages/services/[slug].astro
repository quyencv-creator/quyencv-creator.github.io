---
import Base from '../../layouts/Base.astro';
import { services, BOOKING_URL, priceLabel } from '../../data/services';
import { url } from '../../utils';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service: s } = Astro.props;
const booking = BOOKING_URL[s.slug];
const faq = s.faq.filter((f) => f.a.trim());
const others = services.filter((x) => x.slug !== s.slug);
---
<Base title={s.title} description={s.summary}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href={url('/services/')}>Dịch vụ</a><span aria-hidden="true">/</span><span>{s.title}</span>
  </nav>

  <div class="svc-detail">
    <div class="svc-main">
      <header class="svc-detail-head">
        <span class={`lp-icon ${s.icon}`} aria-hidden="true"></span>
        <h1>{s.title}</h1>
        <p class="lead">{s.summary}</p>
        <p class="svc-outcome"><strong>Sau buổi:</strong> {s.outcome}</p>
      </header>

      <section class="svc-block">
        <h2>Dành cho ai</h2>
        <ul class="checks">{s.audience.map((x) => <li>{x}</li>)}</ul>
      </section>

      <section class="svc-block">
        <h2>Phạm vi hỗ trợ</h2>
        <ul class="checks">{s.scope.map((x) => <li>{x}</li>)}</ul>
      </section>

      <section class="svc-block">
        <h2>Không bao gồm</h2>
        <ul class="crosses">{s.outOfScope.map((x) => <li>{x}</li>)}</ul>
      </section>

      {faq.length > 0 && (
        <section class="svc-block">
          <h2>Câu hỏi thường gặp</h2>
          <div class="faq">
            {faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}
    </div>

    <aside class="svc-aside">
      <div class="svc-book">
        <dl>
          <div><dt>Giá</dt><dd>{priceLabel(s.price)}</dd></div>
          <div><dt>Thời lượng</dt><dd>{s.duration}</dd></div>
          <div><dt>Hình thức</dt><dd>{s.format}</dd></div>
        </dl>
        {booking
          ? <a class="button lg" href={booking} target="_blank" rel="noopener">Đặt lịch</a>
          : <a class="button lg" href={url('/contact/')}>Liên hệ đặt lịch</a>}
        <p class="svc-note">Gửi trước mục tiêu của buổi để buổi làm việc tập trung đúng vấn đề.</p>
      </div>
    </aside>
  </div>

  {others.length > 0 && (
    <section class="lp-section">
      <p class="lp-kicker">Dịch vụ khác</p>
      <div class="svc-others">
        {others.map((o) => (
          <a class="svc-other" href={url(`/services/${o.slug}/`)}>
            <span class={`lp-icon ${o.icon}`} aria-hidden="true"></span>
            <span><strong>{o.title}</strong><span>{o.summary}</span></span>
            <span class="more">Xem chi tiết →</span>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>
