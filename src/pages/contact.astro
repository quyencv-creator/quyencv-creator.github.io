---
import Base from '../layouts/Base.astro';
import { CONTACT } from '../data/contact';
import { url } from '../utils';
---
<Base title="Liên hệ" description="Gửi yêu cầu liên hệ hoặc đặt lịch hẹn online.">
  <h1>Liên hệ</h1>
  <p class="lead">
    Bạn cần hỗ trợ, muốn hỏi về <a href={url('/services/')}>dịch vụ</a> hoặc trao đổi về bài viết?
    Gửi yêu cầu qua form, mình sẽ phản hồi sớm nhất có thể.
  </p>

  <div class="actions">
    <a class="button" href={CONTACT.form} target="_blank" rel="noopener">Gửi yêu cầu liên hệ</a>
    <a class="button secondary" href={CONTACT.booking} target="_blank" rel="noopener">Đặt lịch</a>
  </div>

  <h2>Kết nối</h2>
  <ul class="social">
    {CONTACT.social.map((s) => (
      <li><a href={s.href} target="_blank" rel="noopener me">{s.label}</a></li>
    ))}
  </ul>
</Base>
