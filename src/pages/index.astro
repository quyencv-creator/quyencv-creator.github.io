---
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import { SITE_DESCRIPTION, LANGUAGE_TAGS } from '../consts';
import { getPosts, formatDate, url } from '../utils';
import { getAllSeries } from '../utils-series';

const all = await getPosts();
const allSeries = await getAllSeries();
const [featured, ...rest] = all;
const latest = rest.slice(0, 6);

const count = (tag: string) => all.filter((p) => p.data.tags.includes(tag)).length;
// Biểu đồ chủ đề: tag có nhiều bài nhất ở trên, thanh dài theo số bài.
const TOP_TAGS = 10;
const allTags = [...new Set(all.flatMap((p) => p.data.tags))];
const label = (t: string) => LANGUAGE_TAGS.find((l) => l.tag === t)?.label ?? `#${t}`;
const tagStats = allTags
  .map((t) => ({ tag: t, label: label(t), n: count(t) }))
  .sort((a, b) => b.n - a.n || a.tag.localeCompare(b.tag))
  .slice(0, TOP_TAGS);
const maxCount = Math.max(1, ...tagStats.map((t) => t.n));
---
<Base>
  <section class="hero">
    <p class="eyebrow">Xin chào, mình là Quyền 👋</p>
    <h1>Ghi chép thực chiến về <span class="hl">Golang</span>, <span class="hl">Ruby</span> và cách làm phần mềm tốt hơn.</h1>
    <p class="lead">{SITE_DESCRIPTION}</p>
    <div class="actions">
      <a class="button" href={url('/posts/')}>Đọc bài viết</a>
      <a class="button secondary" href={url('/services/')}>Mentoring 1-1</a>
    </div>
  </section>

  {featured && (
    <section>
      <h2 class="section-title">Bài mới nhất</h2>
      <a class="featured" href={url(`/blog/${featured.id}/`)}>
        <Cover title={featured.data.title} tags={featured.data.tags} pubDate={featured.data.pubDate} cover={featured.data.cover} />
        <div class="featured-body">
        <time datetime={featured.data.pubDate.toISOString()}>{formatDate(featured.data.pubDate)}</time>
        <h3>{featured.data.title}</h3>
        <p>{featured.data.description}</p>
        <span class="chips">{featured.data.tags.map((t) => <span>#{t}</span>)}</span>
        <span class="more">Đọc tiếp →</span>
        </div>
      </a>
    </section>
  )}

  {allSeries.length > 0 && (
    <section>
      <h2 class="section-title">Series</h2>
      <div class="series-list compact">
        {allSeries.map((s) => (
          <a class="series-card" href={url(`/series/${s.slug}/`)}>
            <p class="series-label">Series · {s.posts.length} phần</p>
            <h3>{s.title}</h3>
            <p class="series-desc">{s.description}</p>
          </a>
        ))}
      </div>
      <p class="see-all"><a href={url('/series/')}>Tất cả series →</a></p>
    </section>
  )}

  <section>
    <h2 class="section-title">Chủ đề</h2>
    <ul class="tag-chart">
      {tagStats.map(({ tag, label, n }) => (
        <li>
          <a href={url(`/tags/${tag}/`)} title={`${n} bài về ${label}`}>
            <span class="tag-name">{label}</span>
            <span class="tag-track"><span class="tag-bar" style={`width: ${(n / maxCount) * 100}%`} /></span>
            <span class="tag-count">{n}</span>
          </a>
        </li>
      ))}
    </ul>
    {allTags.length > TOP_TAGS && <p class="see-all"><a href={url('/tags/')}>Tất cả {allTags.length} tag →</a></p>}
  </section>

  {latest.length > 0 && (
    <section>
      <h2 class="section-title">Bài viết gần đây</h2>
      <div class="grid">
        {latest.map((p) => (
          <a class="post-card" href={url(`/blog/${p.id}/`)}>
            <Cover title={p.data.title} tags={p.data.tags} pubDate={p.data.pubDate} cover={p.data.cover} />
            <div class="post-card-body">
            <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
            <h3>{p.data.title}</h3>
            <p>{p.data.description}</p>
            </div>
          </a>
        ))}
      </div>
      <p class="see-all"><a href={url('/posts/')}>Xem tất cả bài viết →</a></p>
    </section>
  )}

  <section class="cta-box">
    <h2>Cần người cùng gỡ rối?</h2>
    <p>IT support và mentor cho junior dev, trao đổi 1-1 qua gọi video.</p>
    <div class="actions">
      <a class="button" href={url('/services/')}>Xem dịch vụ</a>
      <a class="button secondary" href={url('/contact/')}>Liên hệ</a>
    </div>
  </section>
</Base>
