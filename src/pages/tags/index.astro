---
import Base from '../../layouts/Base.astro';
import { getPosts, url } from '../../utils';
import { LANGUAGE_TAGS } from '../../consts';
import { tagColors } from '../../cover';

const posts = await getPosts();
const counts = new Map<string, number>();
posts.flatMap((p) => p.data.tags).forEach((t) => counts.set(t, (counts.get(t) ?? 0) + 1));

const max = Math.max(1, ...counts.values());
// Cạnh ô (1–3 ô lưới) tỉ lệ với căn bậc hai số bài → diện tích ô tỉ lệ với số bài.
const side = (n: number) => Math.min(3, Math.max(1, Math.round(Math.sqrt(n / max) * 3)));
const label = (t: string) => LANGUAGE_TAGS.find((l) => l.tag === t)?.label ?? t;

const tiles = [...counts]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([tag, n]) => ({ tag, n, label: label(tag), size: side(n), ...tagColors(tag) }));
---
<Base title="Tag" description={`${tiles.length} chủ đề, ${posts.length} bài viết.`}>
  <h1>Tag</h1>
  <p class="lead">{tiles.length} chủ đề · {posts.length} bài viết. Ô càng lớn, chủ đề càng nhiều bài.</p>

  <ul class="tag-mosaic">
    {tiles.map(({ tag, n, label, size, from, to }) => (
      <li class={`s${size}`} style={`--from: ${from}; --to: ${to}`}>
        <a href={url(`/tags/${tag}/`)} aria-label={`${label}: ${n} bài`}>
          <span class="name">{label}</span>
          <span class="count">{n} bài</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
