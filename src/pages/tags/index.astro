---
import Base from '../../layouts/Base.astro';
import { getPosts, url } from '../../utils';
const posts = await getPosts();
const counts = new Map<string, number>();
posts.flatMap((p) => p.data.tags).forEach((t) => counts.set(t, (counts.get(t) ?? 0) + 1));
const tags = [...counts].sort((a, b) => b[1] - a[1]);
---
<Base title="Tag">
  <h1>Tag</h1>
  <p>{tags.map(([t, n]) => <a class="tag" href={url(`/tags/${t}/`)}>#{t} ({n})</a>)}</p>
</Base>
