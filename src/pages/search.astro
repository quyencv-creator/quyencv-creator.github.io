---
import Base from '../layouts/Base.astro';
import { url } from '../utils';
---
<Base title="Tìm kiếm" description="Tìm kiếm bài viết trên blog.">
  <h1>Tìm kiếm</h1>
  <form class="search-form" role="search" action={url('/search/')} method="get">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M10 2a8 8 0 0 1 6.32 12.9l5.39 5.4-1.41 1.4-5.4-5.39A8 8 0 1 1 10 2zm0 2a6 6 0 1 0 0 12 6 6 0 0 0 0-12z"/></svg>
    <input id="q" name="q" type="search" placeholder="Nhập từ khoá, có dấu hay không dấu đều được..." autocomplete="off" autofocus aria-label="Từ khoá tìm kiếm" />
  </form>
  <p id="search-status" class="search-status" aria-live="polite"></p>
  <ol id="search-results" class="search-results"></ol>

  <script is:inline define:vars={{ indexUrl: url('/search-index.json'), base: url('') }}>
    // Gấp chữ: bỏ dấu tiếng Việt và viết thường, giữ nguyên độ dài chuỗi để vị trí khớp trên bản gấp
    // dùng được để cắt đoạn trích trên bản gốc.
    const foldChar = (c) => (c === 'đ' || c === 'Đ' ? 'd' : c.normalize('NFD')[0].toLowerCase());
    const fold = (s) => Array.from(s, foldChar).join('');
    const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);

    const input = document.getElementById('q');
    const status = document.getElementById('search-status');
    const list = document.getElementById('search-results');
    let docs = null;

    async function load() {
      if (docs) return docs;
      status.textContent = 'Đang tải chỉ mục...';
      const raw = await (await fetch(indexUrl)).json();
      docs = raw.map((d) => {
        // Array.from để tách đúng theo ký tự (code point), khớp với cách fold() tính độ dài.
        const body = Array.from(d.b);
        return { ...d, body, ft: fold(d.t), fd: fold(d.d), fg: fold(d.g.join(' ') + ' ' + d.tg.join(' ')), fb: fold(d.b),
          lower: (d.t + ' ' + d.d + ' ' + d.b).toLowerCase() };
      });
      return docs;
    }

    // Khớp theo từ: từ khoá phải bắt đầu ở đầu một từ. Từ khoá ngắn (dưới 5 ký tự, phần lớn âm tiết tiếng Việt)
    // phải khớp nguyên từ, để "tro" khớp "trỏ" mà không khớp "trong"; từ khoá dài cho khớp tiền tố ("gorout").
    const isWordChar = (c) => c !== undefined && /[a-z0-9_]/.test(c);
    const matchAt = (hay, term, i) => !isWordChar(hay[i - 1]) && (term.length >= 5 || !isWordChar(hay[i + term.length]));
    function count(hay, term) {
      let n = 0, i = 0;
      while ((i = hay.indexOf(term, i)) !== -1) {
        if (matchAt(hay, term, i)) n++;
        i += term.length;
      }
      return n;
    }

    // Đánh dấu các từ khoá trong một đoạn văn bản gốc, dựa trên vị trí trong bản gấp.
    function highlight(orig, terms) {
      const chars = Array.from(orig);
      const folded = chars.map(foldChar).join('');
      const marks = new Array(chars.length).fill(false);
      for (const t of terms) {
        let i = 0;
        while ((i = folded.indexOf(t, i)) !== -1) {
          if (matchAt(folded, t, i)) for (let k = i; k < i + t.length; k++) marks[k] = true;
          i += t.length;
        }
      }
      let out = '', open = false;
      chars.forEach((c, k) => {
        if (marks[k] && !open) { out += '<mark>'; open = true; }
        if (!marks[k] && open) { out += '</mark>'; open = false; }
        out += esc(c);
      });
      return out + (open ? '</mark>' : '');
    }

    function snippet(d, terms) {
      const firstAt = (t) => { let i = 0; while ((i = d.fb.indexOf(t, i)) !== -1) { if (matchAt(d.fb, t, i)) return i; i += t.length; } return Infinity; };
      // Ưu tiên chỗ có nguyên cụm từ khoá; không có thì lấy vị trí khớp sớm nhất của bất kỳ từ nào.
      const phraseAt = terms.length > 1 ? firstAt(terms.join(' ')) : Infinity;
      const pos = isFinite(phraseAt) ? phraseAt : Math.min(...terms.map(firstAt));
      if (!isFinite(pos)) return highlight(d.d, terms);
      let from = Math.max(0, pos - 80), to = Math.min(d.body.length, pos + 160);
      // Không cắt giữa chữ: lùi điểm đầu tới sau dấu cách gần nhất, tiến điểm cuối tới dấu cách tiếp theo.
      while (from > 0 && d.body[from - 1] !== ' ') from++;
      while (to < d.body.length && d.body[to] !== ' ') to++;
      return (from > 0 ? '… ' : '') + highlight(d.body.slice(from, to).join(''), terms) + (to < d.body.length ? ' …' : '');
    }

    async function search(q) {
      const terms = fold(q).split(/\s+/).filter((t) => t.length > 1);
      // Từ khoá gõ có dấu: bài khớp đúng dấu được ưu tiên ("bảng" xếp trên "bằng").
      const accented = q.toLowerCase().split(/\s+/).filter((t) => t.length > 1 && fold(t) !== t);
      if (terms.length === 0) { list.innerHTML = ''; status.textContent = ''; return; }
      const all = await load();
      const hits = [];
      for (const d of all) {
        let score = 0, matchedAll = true;
        for (const t of terms) {
          const s = count(d.ft, t) * 20 + count(d.fg, t) * 8 + count(d.fd, t) * 5 + Math.min(count(d.fb, t), 30);
          if (s === 0) { matchedAll = false; break; }
          score += s;
        }
        // Ưu tiên bài có nguyên cụm từ khoá.
        const phrase = terms.join(' ');
        if (matchedAll && terms.length > 1 && (d.ft + ' ' + d.fb).includes(phrase)) score += 50;
        if (matchedAll) for (const a of accented) score += Math.min(count(d.lower, a), 10) * 6;
        if (matchedAll) hits.push({ d, score });
      }
      hits.sort((a, b) => b.score - a.score);
      status.textContent = hits.length ? `${hits.length} bài viết khớp với “${q}”` : `Không tìm thấy bài viết nào khớp với “${q}”.`;
      list.innerHTML = hits.slice(0, 30).map(({ d }) => `
        <li>
          <a href="${base}/blog/${d.id}/">${highlight(d.t, terms)}</a>
          <p class="search-snippet">${snippet(d, terms)}</p>
          <p class="search-meta">${esc(d.dt)} · ${d.g.map((g) => '#' + esc(g)).join(' ')}</p>
        </li>`).join('');
    }

    let timer;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        const q = input.value.trim();
        const u = new URL(location.href);
        q ? u.searchParams.set('q', q) : u.searchParams.delete('q');
        history.replaceState(null, '', u);
        search(q);
      }, 120);
    });
    document.querySelector('.search-form').addEventListener('submit', (e) => { e.preventDefault(); search(input.value.trim()); });

    const initial = new URLSearchParams(location.search).get('q');
    if (initial) { input.value = initial; search(initial); }
  </script>
</Base>
