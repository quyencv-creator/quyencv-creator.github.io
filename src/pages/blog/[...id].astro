---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import PostCard from '../../components/mag/PostCard.astro';
import { getPosts, formatDate, url } from '../../utils';
import { AUTHOR, tagLabel } from '../../consts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post, all: posts } }));
}
const { post, all } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags, cover, series } = post.data;
const minutes = Math.max(1, Math.round((post.body ?? '').split(/\s+/).filter(Boolean).length / 300));

// Bài liên quan: nhiều tag chung nhất, cùng điểm thì bài mới hơn trước.
const related = all
  .filter((p) => p.id !== post.id)
  .map((p) => ({ p, score: p.data.tags.filter((t) => tags.includes(t)).length + (series && p.data.series === series ? 2 : 0) }))
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score || b.p.data.pubDate.valueOf() - a.p.data.pubDate.valueOf())
  .slice(0, 3)
  .map((x) => x.p);
const recent = all.filter((p) => p.id !== post.id).slice(0, 4);
const pageUrl = new URL(url(`/blog/${post.id}/`), Astro.site).href;
const enc = encodeURIComponent;
---
<Base title={title} description={description} type="article" image={cover ?? `/og/${post.id}.png`} wide>
  <div class="post-layout">
    <article class="post-main">
      <div class="post-hero-img"><Cover title={title} tags={tags} pubDate={pubDate} cover={cover} art /></div>
      <h1 class="post-h1">{title}</h1>
      <p class="mag-byline post-byline">
        <span class="avatar" aria-hidden="true">{AUTHOR.initial}</span>
        <span>
          <strong>{AUTHOR.name}</strong>
          <span class="post-byline-meta">
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
            {updatedDate && <span> · cập nhật {formatDate(updatedDate)}</span>}
            <span> · {minutes} phút đọc</span>
          </span>
        </span>
      </p>
      {series && <SeriesNav series={series} currentId={post.id} />}
      <div class="post-content"><Content /></div>
    </article>

    <aside class="post-aside" aria-label="Thông tin bài viết">
      <section>
        <h2>Chủ đề</h2>
        <p class="aside-chips">{tags.map((t) => <a href={url(`/tags/${t}/`)}>{tagLabel(t)}</a>)}</p>
      </section>
      <section>
        <h2>Chia sẻ</h2>
        <p class="share">
          <a href={`https://www.facebook.com/sharer/sharer.php?u=${enc(pageUrl)}`} target="_blank" rel="noopener" aria-label="Chia sẻ lên Facebook" title="Facebook">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0 0 22 12z"/></svg>
          </a>
          <a href={`https://twitter.com/intent/tweet?url=${enc(pageUrl)}&text=${enc(title)}`} target="_blank" rel="noopener" aria-label="Chia sẻ lên X" title="X">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.2-8.3L1.8 3h6.4l4.4 5.8zm-1.1 16.2h1.7L7.4 4.7H5.6z"/></svg>
          </a>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${enc(pageUrl)}`} target="_blank" rel="noopener" aria-label="Chia sẻ lên LinkedIn" title="LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zm7 0h3.8v1.6h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6.1V21h-4v-5.1c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V21h-4z"/></svg>
          </a>
          <button type="button" class="copy-link" data-url={pageUrl} aria-label="Sao chép link" title="Sao chép link">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M10.6 13.4a1 1 0 0 1 0-1.4l3.5-3.5a1 1 0 1 1 1.4 1.4L12 13.4a1 1 0 0 1-1.4 0zM8.5 19.5a3.5 3.5 0 0 1-2.5-6l2.1-2.1 1.4 1.4-2.1 2.1a1.5 1.5 0 1 0 2.1 2.1l2.1-2.1 1.4 1.4-2.1 2.1a3.5 3.5 0 0 1-2.4 1.1zm7.4-6.9-1.4-1.4 2.1-2.1a1.5 1.5 0 1 0-2.1-2.1l-2.1 2.1-1.4-1.4 2.1-2.1a3.5 3.5 0 1 1 5 5z"/></svg>
          </button>
        </p>
      </section>
      <section>
        <h2>Theo dõi bài mới</h2>
        <a class="follow" href={url('/rss.xml')}>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M5 3a16 16 0 0 1 16 16h-3A13 13 0 0 0 5 6V3zm0 6a10 10 0 0 1 10 10h-3a7 7 0 0 0-7-7V9zm2 8a2 2 0 1 1 0 4 2 2 0 0 1 0-4z"/></svg>
          Đăng ký qua RSS
        </a>
      </section>
      <section>
        <h2>Bài mới</h2>
        <ul class="aside-recent">
          {recent.map((p) => (
            <li><a href={url(`/blog/${p.id}/`)}>{p.data.title}</a><time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time></li>
          ))}
        </ul>
      </section>
    </aside>
  </div>

  {related.length > 0 && (
    <section class="related-band">
      <div class="related-inner">
        <h2 class="mag-h2">Bài viết liên quan</h2>
        <div class="mag-grid">{related.map((p) => <PostCard post={p} />)}</div>
      </div>
    </section>
  )}

  <script is:inline>
    document.querySelectorAll('.copy-link').forEach((b) => b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.url); b.classList.add('done'); b.title = 'Đã sao chép'; } catch {}
      setTimeout(() => { b.classList.remove('done'); b.title = 'Sao chép link'; }, 1600);
    }));
  </script>
</Base>
